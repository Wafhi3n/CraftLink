# Packaging CurseForge / BigWigs packager de CraftLink.
# Depuis la 0.1.0 (spec docs/specs/addon-partage.md), CraftLink est un ADDON installé à part : il
# partage les recettes connues du joueur. Le dossier CraftLink-1.0 reste la bibliothèque que d'autres
# addons embarquent encore (Crafting Order jusqu'à l'étape 6 de la spec, Guild Economy sur l'Era).

package-as: CraftLink

enable-nolib-creation: no

# La lib embarque LibStub. Pas de dépendances externes téléchargées.
externals: {}

ignore:
    - sync-libs.ps1
    - README.md
    - docs
    - tools
    - .gitignore
    - .gitattributes
    - .pkgmeta
